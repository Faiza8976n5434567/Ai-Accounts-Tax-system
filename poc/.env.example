# Copy to .env.local and fill in. Never commit real values.
# Browser-visible values must start with VITE_ (this is a Vite app).

VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only (Vercel functions) — never prefix with VITE_
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
RESEND_API_KEY=re_...

APP_BASE_URL=http://localhost:5180
